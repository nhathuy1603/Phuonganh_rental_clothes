PORT=4000
DATABASE_URL=postgresql://postgres:local_dev_password@localhost:5432/phuong_anh?schema=public

# Các domain frontend được phép gọi API, ngăn cách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:5173
# URL công khai của API, dùng để tạo link ảnh upload.
PUBLIC_API_URL=http://localhost:4000
# Thư mục lưu ảnh upload.
UPLOAD_DIR=uploads

# Đăng nhập admin. Tạo hash bằng: npm run admin:hash -- "mat-khau-moi"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Chuỗi ngẫu nhiên dùng ký phiên đăng nhập (bắt buộc >= 32 ký tự khi production).
AUTH_SECRET=
ADMIN_SESSION_HOURS=12

# Đăng nhập bằng Google cho khách (để trống để tắt). Tạo tại console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
