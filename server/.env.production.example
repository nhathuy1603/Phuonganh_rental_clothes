NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/phuong_anh?schema=public&sslmode=require

CORS_ORIGINS=https://phuonganhthuedodanang.com,https://www.phuonganhthuedodanang.com,https://admin.phuonganhthuedodanang.com
PUBLIC_API_URL=https://api.phuonganhthuedodanang.com
# Đặt vào ổ đĩa bền vững (volume / persistent disk), không để trong thư mục build.
UPLOAD_DIR=/data/uploads
# Bật khi chạy sau reverse proxy (Nginx, Render, Railway...) để rate limit đăng nhập nhận đúng IP.
TRUST_PROXY=true

ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
ADMIN_SESSION_HOURS=12

# Đăng nhập bằng Google cho khách (để trống để tắt). Tạo tại console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
